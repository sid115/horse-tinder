generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  disabled     Boolean  @default(false)
  displayName  String
  email        String?
  phone        String?
  createdAt    DateTime @default(now())
  horses       Horse[]
  swipes       Swipe[]
  matchesA     Match[]  @relation("MatchUserA")
  matchesB     Match[]  @relation("MatchUserB")
  messages     Message[]
}

model Horse {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  sex                String
  dob                DateTime
  breedName          String
  breedHistory       String?
  heightHands        Float?
  color              String?
  markings           String?
  discipline         String
  temperament        String?
  registrationNumber String?
  sireName           String?
  damName            String?
  allergies          String?
  healthIssues       String?
  location           String?
  lat                Float?
  lng                Float?
  studFee            Int?
  breedingTerms      String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  photos             Photo[]
  swipes             Swipe[]
  @@index([ownerId])
}

model Photo {
  id        String  @id @default(cuid())
  horseId   String
  horse     Horse   @relation(fields: [horseId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
  @@index([horseId])
}

model Swipe {
  id           String   @id @default(cuid())
  swiperUserId String
  swiper       User     @relation(fields: [swiperUserId], references: [id], onDelete: Cascade)
  horseId      String
  horse        Horse    @relation(fields: [horseId], references: [id], onDelete: Cascade)
  direction    String
  createdAt    DateTime @default(now())
  @@unique([swiperUserId, horseId])
  @@index([horseId, direction])
}

model Match {
  id        String    @id @default(cuid())
  userAId   String
  userA     User      @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User      @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  Message[]
  @@unique([userAId, userBId])
}

model Message {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderUserId String
  sender       User     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime @default(now())
  @@index([matchId, createdAt])
}
